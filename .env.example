# Copy to .env.local and fill in (start.bat does this and generates the two secrets for you).
# /demo works without any of these.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only if you add Gmail later (Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts inbox passwords/tokens in the database. 32 random bytes, base64. Never change it after users connect.
TOKEN_ENCRYPTION_KEY=

# Protects the daily re-scan endpoint (Vercel Cron sends it automatically).
CRON_SECRET=

# Reminder emails via Resend (resend.com → API Keys). Without a verified domain,
# Resend's test sender only delivers to the email you signed up to Resend with.
RESEND_API_KEY=
REMINDER_FROM=SubTrack <onboarding@resend.dev>

# Optional: AI fallback for unknown merchants
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
